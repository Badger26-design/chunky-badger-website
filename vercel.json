{
    "buildCommand": "",
    "outputDirectory": ".",
    "headers": [
        {
            "source": "/Pictures/(.*)",
            "headers": [
                {
                    "key": "Cache-Control",
                    "value": "public, max-age=31536000, immutable"
                }
            ]
        }
    ],
    "redirects": [
        {
            "source": "/index.html",
            "destination": "/",
            "permanent": true
        },
        {
            "source": "/kids-how-to-draw-books.html",
            "destination": "/how-to-draw-books.html",
            "permanent": true
        },
        {
            "source": "/learn-to-draw-books.html",
            "destination": "/how-to-draw-books.html",
            "permanent": true
        },
        {
            "source": "/kids-how-to-draw.html",
            "destination": "/how-to-draw-books.html",
            "permanent": true
        },
        {
            "source": "/how-to-draw-wildlife-book-for-kids.html",
            "destination": "/how-to-draw-animals.html",
            "permanent": true
        },
        {
            "source": "/animal-drawing-book.html",
            "destination": "/how-to-draw-animals.html",
            "permanent": true
        },
        {
            "source": "/learn-to-draw-animals-books-for-kids.html",
            "destination": "/how-to-draw-animals.html",
            "permanent": true
        },
        {
            "source": "/how-to-draw-animals-book-for-kids.html",
            "destination": "/how-to-draw-animals.html",
            "permanent": true
        }
    ],
    "rewrites": [
        {
            "source": "/api/subscribe",
            "destination": "/api/subscribe.js"
        }
    ]
}